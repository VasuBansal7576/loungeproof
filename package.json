{
  "name": "loungeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "sources": "python3 scripts/fetch_sources.py",
    "sanity": "sanity",
    "eval": "node --import tsx scripts/evaluate.ts",
    "verify:agent": "node --import tsx scripts/verify-agent.ts",
    "curate": "python3 scripts/curate.py",
    "start": "NODE_ENV=production node --import tsx server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sanity/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sanity": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "basic-ftp": "6.2.1",
    "esbuild@>=0.27.3 <0.28.1": "0.28.2",
    "uuid@<11.1.1": "11.1.1"
  }
}
